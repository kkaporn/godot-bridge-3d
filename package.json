{
  "name": "godot-bridge",
  "version": "0.4.2",
  "description": "DSH (DeepSeek Harness) plugin: launch and drive a running Godot 4.x game through its in-game TCP interaction server — replaces the godot-mcp MCP server with native agent tools, and ships game-development skills for the agent.",
  "type": "module",
  "main": "plugin/godot-bridge.mjs",
  "exports": {
    ".": "./plugin/godot-bridge.mjs",
    "./client": "./client/client.js"
  },
  "files": [
    "plugin/",
    "client/",
    "skills/",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "godot",
    "godot-engine",
    "godot-plugin",
    "mcp",
    "game-development",
    "ai-agent"
  ],
  "scripts": {
    "check": "node scripts/check-plugin-contract.mjs && node scripts/lint-skills.mjs",
    "check:contract": "node scripts/check-plugin-contract.mjs",
    "check:skills": "node scripts/lint-skills.mjs && node scripts/verify-installed-skills.mjs",
    "test": "node scripts/lint-skills.test.mjs && node scripts/install-skills.test.mjs && node scripts/run-real-install.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.6-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Smalldy/godot-bridge.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
