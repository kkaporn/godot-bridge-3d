+func _cmd_build_occluder(params: Dictionary) -> void:
+	_send_response(build_occluder_core(params))
+
+
+func build_occluder_core(params: Dictionary) -> Dictionary:
+	var node_path: String = str(params.get("node_path", ""))
+	var node = get_tree().root.get_node_or_null(node_path)
+	if node == null:
+		return {"error": "Node not found: %s" % node_path}
+	var meshes: Array = []
+	_collect_mesh_instances(node, meshes)
+	if meshes.is_empty():
+		return {"error": "No MeshInstance3D found at or under %s" % node_path}
+
+	var occluder_path: String = str(params.get("occluder_path", ""))
+	var occluder_node = null
+	if not occluder_path.is_empty():
+		occluder_node = get_tree().root.get_node_or_null(occluder_path)
+		if occluder_node == null or not (occluder_node is OccluderInstance3D):
+			return {"error": "occluder_path must point at an existing OccluderInstance3D: %s" % occluder_path}
+	else:
+		var parent = node.get_parent()
+		if parent == null:
+			return {"error": "node has no parent; create the OccluderInstance3D yourself and pass occluder_path"}
+		occluder_node = OccluderInstance3D.new()
+		occluder_node.name = str(params.get("name", "BakedOccluder"))
+		parent.add_child(occluder_node)
+		if node is Node3D:
+			occluder_node.global_transform = (node as Node3D).global_transform
+
+	var to_local: Transform3D = (occluder_node as Node3D).global_transform.affine_inverse()
+	var vertices := PackedVector3Array()
+	var indices := PackedInt32Array()
+	var offset := 0
+	var surfaces := 0
+	for entry in meshes:
+		var mi := entry as MeshInstance3D
+		var mesh = mi.mesh
+		if mesh == null:
+			continue
+		var xf: Transform3D = to_local * mi.global_transform
+		for s in mesh.get_surface_count():
+			var arrays = mesh.surface_get_arrays(s)
+			if arrays.size() == 0 or arrays[Mesh.ARRAY_VERTEX] == null:
+				continue
+			var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
+			var idx = arrays[Mesh.ARRAY_INDEX]
+			if idx == null or (idx as PackedInt32Array).is_empty():
+				var generated := PackedInt32Array()
+				generated.resize(verts.size())
+				for i in verts.size():
+					generated[i] = i
+				idx = generated
+			for i in verts.size():
+				vertices.append(xf * verts[i])
+			for i in (idx as PackedInt32Array).size():
+				indices.append((idx as PackedInt32Array)[i] + offset)
+			offset += verts.size()
+			surfaces += 1
+	if vertices.is_empty() or indices.is_empty():
+		return {"error": "No triangle data found at or under %s" % node_path}
+	var occ := ArrayOccluder3D.new()
+	occ.set_arrays(vertices, indices)
+	(occluder_node as OccluderInstance3D).occluder = occ
+	return {
+		"success": true,
+		"occluder_path": str(occluder_node.get_path()),
+		"surfaces": surfaces,
+		"vertices": vertices.size(),
+		"indices": indices.size(),
+		"source_meshes": meshes.size(),
+	}
+
+
+# --- G7b precondition check: is this scene ready for the editor bake button? ---
+# Read-only. The bake itself has no scriptable API in 4.7.2 (verified: even a
+# direct LightmapGIEditorPlugin._bake() call produced 0 lightmaps), so the
+# automatable half is making sure the human's single click actually does work.
+func _cmd_lightmap_check(params: Dictionary) -> void:
+	_send_response(lightmap_check_core(params))
+
+
+func _collect_nodes_by_class(node: Node, class_filter: String, out: Array) -> void:
+	if node.is_class(class_filter):
+		out.append(node)
+	for child in node.get_children():
+		_collect_nodes_by_class(child, class_filter, out)
