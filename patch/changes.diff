+func lightmap_check_core(params: Dictionary) -> Dictionary:
+	var scope_path := str(params.get("node_path", ""))
+	var scope: Node = null
+	if scope_path.is_empty():
+		scope = get_tree().current_scene
+		if scope == null:
+			scope = get_tree().root
+	else:
+		scope = get_tree().root.get_node_or_null(scope_path)
+		if scope == null:
+			return {"error": "Node not found: %s" % scope_path}
+	var scene_root = get_tree().current_scene
+	var max_items: int = max(1, int(params.get("max_items", 40)))
+
+	var lightmaps: Array = []
+	var mesh_nodes: Array = []
+	var light_nodes: Array = []
+	_collect_nodes_by_class(scope, "LightmapGI", lightmaps)
+	_collect_nodes_by_class(scope, "MeshInstance3D", mesh_nodes)
+	_collect_nodes_by_class(scope, "Light3D", light_nodes)
+
+	var blockers: Array = []
+	var warnings: Array = []
+
+	var lightmap_report: Array = []
+	for item in lightmaps:
+		var lgi := item as LightmapGI
+		var direct := scene_root != null and lgi.get_parent() == scene_root
+		# the property is named `quality` (the accessor is get_bake_quality)
+		var quality = lgi.get("quality")
+		if quality == null:
+			quality = lgi.get("bake_quality")
+		var entry := {
+			"path": str(lgi.get_path()),
+			"is_direct_child_of_scene_root": direct,
+			"has_light_data": lgi.light_data != null,
+			"texel_scale": lgi.get("texel_scale"),
+			"quality": quality,
+			"visible": lgi.visible,
+		}
+		lightmap_report.append(entry)
+		if not direct:
+			blockers.append("%s 不是场景根的直接子节点；编辑器的烘焙按钮只处理场景根的直接子节点" % entry["path"])
+		if not lgi.visible:
+			warnings.append("%s 被隐藏（visible=false）" % entry["path"])
+		if lgi.light_data != null:
+			warnings.append("%s 已有 light_data，重新烘焙会覆盖它" % entry["path"])
+	if lightmaps.is_empty():
+		blockers.append("作用域里没有 LightmapGI 节点")
+
+	var mesh_report: Array = []
+	var static_meshes := 0
+	var static_missing_uv2 := 0
+	var dynamic_meshes := 0
+	for item in mesh_nodes:
+		var mi := item as MeshInstance3D
+		var uv2 := _mesh_uv2_info(mi.mesh)
+		var is_static: bool = mi.gi_mode == GeometryInstance3D.GI_MODE_STATIC
+		if is_static:
+			static_meshes += 1
+			if int(uv2["missing_uv2"]) > 0:
+				static_missing_uv2 += 1
+		else:
+			dynamic_meshes += 1
+		if mesh_report.size() < max_items:
+			mesh_report.append({
+				"path": str(mi.get_path()),
+				"visible": mi.visible,
+				"gi_mode": mi.gi_mode,
+				"gi_mode_static": is_static,
+				"gi_lightmap_scale": mi.gi_lightmap_scale,
+				"surfaces": uv2["surfaces"],
+				"surfaces_with_uv2": uv2["surfaces_with_uv2"],
+				"missing_uv2": uv2["missing_uv2"],
+			})
+	if mesh_nodes.is_empty():
+		blockers.append("作用域里没有 MeshInstance3D")
+	elif static_meshes == 0:
+		blockers.append("没有 gi_mode = STATIC 的 MeshInstance3D（只有静态网格会进光照贴图）")
+	if static_missing_uv2 > 0:
+		blockers.append("%d 个静态网格缺少 UV2 → 先用 godot_command unwrap_lightmap_uv2 生成 UV2" % static_missing_uv2)
+	if dynamic_meshes > 0:
+		warnings.append("%d 个 MeshInstance3D 不是 STATIC（gi_mode=%d），不会被烘进光照贴图" % [dynamic_meshes, GeometryInstance3D.GI_MODE_STATIC])
+
+	var light_report: Array = []
+	var static_lights := 0
+	for item in light_nodes:
+		var li := item as Light3D
+		var mode = li.get("light_bake_mode")
+		var is_static: bool = int(mode) == Light3D.BAKE_STATIC
+		if is_static:
+			static_lights += 1
+		else:
+			warnings.append("%s 的 light_bake_mode=%s（非 STATIC），不会被烘进光照贴图" % [str(li.get_path()), str(mode)])
+		if light_report.size() < max_items:
+			light_report.append({
+				"path": str(li.get_path()),
+				"class": str(li.get_class()),
+				"light_bake_mode": mode,
+				"static_bake": is_static,
+			})
+	if light_nodes.is_empty():
+		warnings.append("作用域里没有 Light3D；烘焙结果会是全黑")
+	elif static_lights == 0:
+		blockers.append("没有 light_bake_mode = STATIC 的灯（烘焙会得到全黑贴图）")
+
+	return {
+		"success": true,
+		"scope": scope_path if not scope_path.is_empty() else "<current_scene>",
+		"scene_root": (str(scene_root.get_path()) if scene_root != null else "<none>"),
+		"lightmaps": lightmap_report,
+		"meshes": mesh_report,
+		"meshes_total": mesh_nodes.size(),
+		"meshes_truncated": mesh_nodes.size() > max_items,
+		"meshes_static": static_meshes,
+		"lights": light_report,
+		"lights_total": light_nodes.size(),
+		"blockers": blockers,
+		"warnings": warnings,
+		"ready_to_bake": blockers.is_empty(),
+		"next_step": ("条件齐了：在编辑器里选中 LightmapGI 节点，点 3D 视口顶部的「烘焙光照贴图」。烘焙本身没有公开脚本 API（4.7.2 实测：直接调 LightmapGIEditorPlugin._bake() 也只有 0 张贴图）。" if blockers.is_empty() else "先解决 blockers，再点烘焙。"),
+	}
+
