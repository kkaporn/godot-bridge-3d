+func _mesh_uv2_info(mesh: Mesh) -> Dictionary:
+	# Mesh subclasses differ: ArrayMesh has surface_get_format(), PrimitiveMesh
+	# (BoxMesh/PlaneMesh/...) does not. Probe dynamically so any Mesh works.
+	var total := 0
+	var with_uv2 := 0
+	if mesh != null:
+		total = mesh.get_surface_count()
+		for i in total:
+			if mesh.has_method("surface_get_format"):
+				if int(mesh.call("surface_get_format", i)) & Mesh.ARRAY_FORMAT_TEX_UV2:
+					with_uv2 += 1
+			elif mesh.has_method("surface_get_arrays"):
+				var arrays = mesh.call("surface_get_arrays", i)
+				if arrays is Array and arrays.size() > Mesh.ARRAY_TEX_UV2 and arrays[Mesh.ARRAY_TEX_UV2] != null:
+					with_uv2 += 1
+			else:
+				with_uv2 += 1  # cannot inspect: do not report a false blocker
+	return {"surfaces": total, "surfaces_with_uv2": with_uv2, "missing_uv2": total - with_uv2}
+
