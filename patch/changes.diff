+# ============================================================================
+# Gap-fill ops
+#   import_info       - read <asset>.import (remap / deps / params) so callers
+#                       never hand-build .godot/imported paths
+#   instantiate_scene - instantiate a PackedScene (.glb/.tscn) into a .tscn,
+#                       optionally replacing a placeholder and keeping its transform
+#   list_subresources - enumerate the sub-resources a mesh/material/animation pack
+#                       exposes (res://x.glb::<Class>_<suffix>)
+# Result is printed as one `RESULT_JSON: {...}` line; stdout is forwarded verbatim.
+# ============================================================================
+
+func _emit_json(payload):
+    print("RESULT_JSON: " + JSON.stringify(payload))
+
+
+func _normalize_res_path(path_value):
+    var p = str(path_value)
+    if p.is_empty() or p.begins_with("res://") or p.begins_with("user://"):
+        return p
+    return "res://" + p
+
+
+func _count_nodes(node):
+    var total = 1
+    for child in node.get_children():
+        total += _count_nodes(child)
+    return total
+
+
+# A .gdignore anywhere up the tree makes the importer skip that directory
+# silently - an import that fails with no error at all.
+func _gdignore_blocking(res_path):
+    var dir = res_path.get_base_dir()
+    while dir.begins_with("res://") and dir.length() > 6:
+        if FileAccess.file_exists(dir.path_join(".gdignore")):
+            return dir
+        var parent = dir.get_base_dir()
+        if parent == dir:
+            break
+        dir = parent
+    if FileAccess.file_exists("res://.gdignore"):
+        return "res://"
+    return ""
+
+
+# Node.get_path() errors on nodes held in a detached scene tree (the usual state
+# inside these ops), so build the path by walking up to the scene root instead.
+func _relative_node_path(node, root):
+    var parts = []
+    var cur = node
+    while cur != null and cur != root:
+        parts.push_front(str(cur.name))
+        cur = cur.get_parent()
+    if parts.is_empty():
+        return "/"
+    return "/" + "/".join(parts)
+
+
+func import_info(params):
+    var res_path = _normalize_res_path(params.get("path", ""))
+    if res_path.is_empty():
+        log_error("path is required (e.g. res://models/player.glb)")
+        quit(1)
+        return
+    var sidecar = res_path + ".import"
+    var out = {
+        "source_file": res_path,
+        "sidecar": sidecar,
+        "sidecar_exists": FileAccess.file_exists(sidecar),
+        "resource_exists": ResourceLoader.exists(res_path),
+        "gdignore_dir": _gdignore_blocking(res_path)
+    }
+    if not out.gdignore_dir.is_empty():
+        out["hint"] = "a .gdignore exists in " + out.gdignore_dir + ": the importer skips that directory silently, so this asset will never import. Remove it (only screenshots/ should carry one)."
+        _emit_json(out)
+        return
+    if not out.sidecar_exists:
+        out["hint"] = "no sidecar: the asset has never been imported. Run godot_run_headless with mode=import first."
+        _emit_json(out)
+        return
+
+    var cf = ConfigFile.new()
+    var err = cf.load(sidecar)
+    if err != OK:
+        out["error"] = "failed to parse sidecar (error %d)" % err
+        _emit_json(out)
+        return
+    if cf.has_section("remap"):
+        var remap = {}
+        for key in cf.get_section_keys("remap"):
+            remap[key] = str(cf.get_value("remap", key))
+        out["remap"] = remap
+        out["importer"] = remap.get("importer", "")
+        out["type"] = remap.get("type", "")
+        out["uid"] = remap.get("uid", "")
+        out["dest_path"] = remap.get("path", "")
+        out["dest_exists"] = FileAccess.file_exists(str(remap.get("path", "")))
+    if cf.has_section("deps"):
+        var deps = {}
+        for key in cf.get_section_keys("deps"):
+            deps[key] = cf.get_value("deps", key)
+        out["deps"] = deps
+    if cf.has_section("params"):
+        var cfg = {}
+        for key in cf.get_section_keys("params"):
+            cfg[key] = cf.get_value("params", key)
+        out["params"] = cfg
+    _emit_json(out)
+    print("Import info for: " + res_path)
+
+
+func instantiate_scene(params):
+    var scene_path = _normalize_res_path(params.get("scene_path", ""))
+    var instance_path = _normalize_res_path(params.get("instance_path", ""))
+    if scene_path.is_empty() or instance_path.is_empty():
+        log_error("scene_path (target .tscn) and instance_path (.glb/.tscn/.scn to add) are required")
+        quit(1)
+        return
+    if not FileAccess.file_exists(scene_path):
+        log_error("Scene not found: " + scene_path)
+        quit(1)
+        return
+    if not ResourceLoader.exists(instance_path):
+        log_error("Instance resource not found: " + instance_path)
+        log_error("If this is a .glb/.gltf/.obj it has not been imported yet - run the import pass first.")
+        quit(1)
+        return
+
+    var scene = load(scene_path)
+    if scene == null or not (scene is PackedScene):
+        log_error("Failed to load PackedScene: " + scene_path)
+        quit(1)
+        return
+    var scene_root = scene.instantiate()
+
+    var replace_path = str(params.get("replace_node_path", ""))
+    var replaced = null
+    var parent = scene_root
+    if not replace_path.is_empty():
+        replaced = _resolve_scene_node(scene_root, replace_path)
+        if replaced == null:
+            log_error("replace_node_path not found: " + replace_path)
+            quit(1)
+        return
+        parent = replaced.get_parent()
+        if parent == null:
+            log_error("replace_node_path has no parent: " + replace_path)
+            quit(1)
+        return
+    else:
+        var parent_path = str(params.get("parent_node_path", "root"))
+        if not parent_path.is_empty() and parent_path != "root":
+            parent = _resolve_scene_node(scene_root, parent_path)
+            if parent == null:
+                log_error("parent_node_path not found: " + parent_path)
+                quit(1)
+        return
+
+    var packed = load(instance_path)
+    if packed == null or not (packed is PackedScene):
+        log_error("Resource is not a PackedScene: " + instance_path)
+        quit(1)
+        return
+    var instance = packed.instantiate()
+    if instance == null:
+        log_error("Failed to instantiate: " + instance_path)
+        quit(1)
+        return
+
+    var desired_name = str(params.get("name", ""))
+    if desired_name.is_empty() and replaced != null:
+        desired_name = str(replaced.name)
+    if replaced != null:
+        replaced.name = str(replaced.name) + "__replaced"
+
+    parent.add_child(instance)
+    instance.owner = scene_root
+    # _set_owner_recursive stops at nested scene instances on purpose, which keeps
+    # the .glb stored as an instance reference instead of an expanded node tree.
+    _set_owner_recursive(instance, scene_root)
+    if not desired_name.is_empty():
