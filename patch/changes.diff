+# ============================================================================
+# 3D gap-fill pack
+# Commands added: render_camera, mesh_collision, csg_bake, get_material_state,
+# unwrap_lightmap_uv2, build_occluder.
+# Every command is split into a *_core() returning a Dictionary plus a thin
+# _cmd_* wrapper, so the logic can be exercised without the socket plumbing.
+# All engine API names verified against Godot 4.7.2 ClassDB:
+#   ArrayMesh.lightmap_unwrap(Transform3D, float) -> Error
+#   CSGShape3D.bake_static_mesh() -> ArrayMesh, bake_collision_shape() -> ConcavePolygonShape3D,
+#   CSGShape3D.get_meshes() -> Array; Mesh.create_trimesh_shape()/create_convex_shape()
+#   MeshInstance3D.create_trimesh_collision()/create_convex_collision()/create_multiple_convex_collisions()
+#   ArrayOccluder3D.set_arrays(PackedVector3Array, PackedInt32Array)
+#   MeshInstance3D.get_active_material(int), Shader.get_shader_uniform_list(bool)
+# ============================================================================
+
+const EXTRA_ENV_KEYS := [
+	# volumetric fog
+	"volumetric_fog_enabled", "volumetric_fog_density", "volumetric_fog_albedo", "volumetric_fog_emission",
+	"volumetric_fog_emission_energy", "volumetric_fog_gi_inject", "volumetric_fog_anisotropy",
+	"volumetric_fog_length", "volumetric_fog_detail_spread", "volumetric_fog_ambient_inject",
+	"volumetric_fog_sky_affect", "volumetric_fog_temporal_reprojection_enabled",
+	"volumetric_fog_temporal_reprojection_amount",
+	# screen-space indirect lighting
+	"ssil_enabled", "ssil_radius", "ssil_intensity", "ssil_sharpness", "ssil_normal_rejection",
+	# SDFGI
+	"sdfgi_enabled", "sdfgi_use_occlusion", "sdfgi_read_sky_light", "sdfgi_bounce_feedback",
+	"sdfgi_cascades", "sdfgi_min_cell_size", "sdfgi_cascade0_distance", "sdfgi_max_distance",
+	"sdfgi_y_scale", "sdfgi_energy", "sdfgi_normal_bias", "sdfgi_probe_bias",
+	# fog, advanced
+	"fog_mode", "fog_light_energy", "fog_sun_scatter", "fog_height", "fog_height_density",
+	"fog_aerial_perspective", "fog_sky_affect", "fog_depth_curve", "fog_depth_begin", "fog_depth_end",
+	# glow, advanced (glow_levels/1..7 are indexed properties)
+	"glow_normalized", "glow_strength", "glow_mix", "glow_blend_mode", "glow_hdr_threshold",
+	"glow_hdr_scale", "glow_hdr_luminance_cap", "glow_map_strength", "glow_map",
+	"glow_levels/1", "glow_levels/2", "glow_levels/3", "glow_levels/4", "glow_levels/5",
+	"glow_levels/6", "glow_levels/7",
+	# background
+	"background_energy_multiplier",
+]
+
+const CSG_CARRY_PROPS := [
+	"cast_shadow", "gi_mode", "gi_lightmap_scale", "lod_bias", "layers", "material_override",
+	"material_overlay", "transparency", "extra_cull_margin", "ignore_occlusion_culling",
+	"visibility_range_begin", "visibility_range_begin_margin", "visibility_range_end",
+	"visibility_range_end_margin", "visibility_range_fade_mode",
+]
+
+
+func _apply_extra_env_keys(env: Environment, params: Dictionary) -> Array:
+	var applied: Array = []
+	for key in EXTRA_ENV_KEYS:
+		if params.has(key):
+			env.set(key, _json_to_variant_for_property(env, key, params[key]))
+			applied.append(key)
+	return applied
+
+
+func _environment_non_default(env: Environment) -> Dictionary:
+	var defaults := Environment.new()
+	var out := {}
+	for key in EXTRA_ENV_KEYS:
+		var value = env.get(key)
+		if value != defaults.get(key):
+			out[key] = _variant_to_json(value)
+	return out
+
+
+# --- G1: render a chosen camera off-screen and optionally save a PNG ---------
+func _cmd_render_camera(params: Dictionary) -> void:
+	_send_response(await render_camera_core(params))
+
+
+func render_camera_core(params: Dictionary) -> Dictionary:
+	var width: int = max(1, int(params.get("width", 640)))
+	var height: int = max(1, int(params.get("height", 360)))
+	var output_path: String = str(params.get("output_path", ""))
+	var camera_path: String = str(params.get("camera_path", ""))
+
+	var sv := SubViewport.new()
+	sv.size = Vector2i(width, height)
+	sv.transparent_bg = bool(params.get("transparent_bg", false))
+	sv.render_target_update_mode = SubViewport.UPDATE_ALWAYS
+	get_tree().root.add_child(sv)
+
+	var cam := Camera3D.new()
+	sv.add_child(cam)
+	var source = get_viewport().get_camera_3d() if camera_path.is_empty() else get_tree().root.get_node_or_null(camera_path)
+	if source == null or not (source is Camera3D):
+		sv.queue_free()
+		return {"error": "Camera3D not found: %s" % (camera_path if not camera_path.is_empty() else "<current viewport camera>")}
+	cam.global_transform = source.global_transform
+	cam.fov = source.fov
+	cam.near = source.near
+	cam.far = source.far
+	cam.projection = source.projection
+	cam.size = source.size
+	cam.keep_aspect = source.keep_aspect
+	if params.has("fov"):
+		cam.fov = float(params["fov"])
+
+	# A headless/dummy renderer has no texture storage: get_image() returns null.
+	await RenderingServer.frame_post_draw
+	var img = sv.get_texture().get_image()
+	if img == null:
+		sv.queue_free()
+		return {"error": "Capture failed: no rendering backend (headless uses the dummy renderer). Use a windowed instance (godot_run_project)."}
+	var out := {"success": true, "width": img.get_width(), "height": img.get_height(), "camera": str(source.get_path())}
+	if output_path.is_empty():
+		out["data"] = Marshalls.raw_to_base64(img.save_png_to_buffer())
+	else:
+		var err: int = img.save_png(output_path)
+		out["output_path"] = output_path
+		out["save_error"] = err
+		if err != OK:
+			out["warning"] = "save_png failed with error %d (check the path; use res://, user:// or an absolute path)" % err
+	sv.queue_free()
+	return out
+
+
+# --- G2: bake collision for an existing MeshInstance3D ----------------------
+func _cmd_mesh_collision(params: Dictionary) -> void:
+	_send_response(mesh_collision_core(params))
+
+
+func mesh_collision_core(params: Dictionary) -> Dictionary:
+	var node_path: String = str(params.get("node_path", ""))
+	var shape_type: String = str(params.get("shape_type", "trimesh"))
+	var node = get_tree().root.get_node_or_null(node_path)
+	if node == null:
+		return {"error": "Node not found: %s" % node_path}
+	if not (node is MeshInstance3D) or (node as MeshInstance3D).mesh == null:
+		return {"error": "node_path must be a MeshInstance3D with a mesh: %s" % node_path}
+	var mesh_inst := node as MeshInstance3D
+	match shape_type:
+		"trimesh":
+			mesh_inst.create_trimesh_collision()
+		"convex":
+			mesh_inst.create_convex_collision()
+		"convex_multi":
+			mesh_inst.create_multiple_convex_collisions()
+		"from_aabb", "from_aabb_sphere", "from_aabb_capsule":
+			# Recommended for imported models: a primitive fitted to the mesh AABB.
+			# Trimesh/convex on detailed imported meshes is a known frame-rate trap,
+			# and raycasts do not reliably hit ConcavePolygonShape3D.
+			var aabb: AABB = mesh_inst.mesh.get_aabb()
+			var shape: Shape3D = null
+			if shape_type == "from_aabb":
+				var box := BoxShape3D.new()
+				box.size = aabb.size
+				shape = box
+			elif shape_type == "from_aabb_sphere":
+				var sphere := SphereShape3D.new()
+				sphere.radius = maxf(0.001, aabb.get_longest_axis_size() * 0.5)
+				shape = sphere
+			else:
+				var capsule := CapsuleShape3D.new()
+				capsule.radius = maxf(0.001, maxf(aabb.size.x, aabb.size.z) * 0.5)
+				capsule.height = maxf(capsule.radius * 2.0, aabb.size.y)
+				shape = capsule
+			var fitted_body := StaticBody3D.new()
+			fitted_body.name = str(params.get("body_name", str(mesh_inst.name) + "_col"))
+			mesh_inst.add_child(fitted_body)
+			var fitted_shape := CollisionShape3D.new()
+			fitted_shape.name = "CollisionShape3D"
+			fitted_shape.shape = shape
+			fitted_shape.position = aabb.get_center()
+			fitted_body.add_child(fitted_shape)
+		_:
+			return {"error": "shape_type must be trimesh | convex | convex_multi | from_aabb | from_aabb_sphere | from_aabb_capsule (trimesh is for static level geometry; imported models should use from_aabb*/convex_multi)"}
+
+	var body = null
+	for child in mesh_inst.get_children():
+		if child is StaticBody3D:
+			body = child
+			break
+	var out := {"success": true, "node_path": node_path, "shape_type": shape_type}
+	if body == null:
+		out["warning"] = "no StaticBody3D was created (mesh has no faces?)"
+		return out
+	if params.has("collision_layer"):
+		body.collision_layer = int(params["collision_layer"])
+	if params.has("collision_mask"):
+		body.collision_mask = int(params["collision_mask"])
+	var shapes: Array = []
+	for child in body.get_children():
+		if child is CollisionShape3D:
+			var shape = (child as CollisionShape3D).shape
+			shapes.append({
+				"name": str(child.name),
+				"shape_class": str(shape.get_class()) if shape != null else "",
+				"path": str(child.get_path())
+			})
+	out["body_path"] = str(body.get_path())
+	out["shapes"] = shapes
+	return out
+
+
+# --- G4: bake a CSG tree into a static mesh / static body -------------------
+func _cmd_csg_bake(params: Dictionary) -> void:
+	_send_response(csg_bake_core(params))
+
+
+func csg_bake_core(params: Dictionary) -> Dictionary:
+	var node_path: String = str(params.get("node_path", ""))
+	var node = get_tree().root.get_node_or_null(node_path)
+	if node == null:
+		return {"error": "Node not found: %s" % node_path}
+	if not (node is CSGShape3D):
+		return {"error": "node_path is not a CSGShape3D: %s" % node_path}
+	var csg := node as CSGShape3D
+	var parent = csg.get_parent()
+	if parent == null:
+		return {"error": "CSG node has no parent: %s" % node_path}
+
+	var mesh = null
+	if str(params.get("source", "bake")) == "get_meshes":
+		var meshes = csg.get_meshes()
+		if meshes.size() > 1:
+			mesh = meshes[1]
+		if mesh == null and meshes.size() > 0:
+			mesh = meshes[0]
+	else:
+		mesh = csg.bake_static_mesh()
+	if mesh == null or mesh.get_surface_count() == 0:
+		return {"error": "CSG produced no mesh; node_path must be a root CSG shape with geometry"}
+
+	var unwrap_error := -1
+	if bool(params.get("unwrap_uv2", false)):
+		var am = mesh as ArrayMesh
+		if am == null:
+			am = ArrayMesh.new()
+			for i in mesh.get_surface_count():
+				am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, mesh.surface_get_arrays(i))
+				am.surface_set_material(i, mesh.surface_get_material(i))
+		unwrap_error = am.lightmap_unwrap(csg.global_transform, float(params.get("texel_size", 0.4)))
+		mesh = am
+
+	var target_name: String = str(params.get("name", "BakedMesh"))
+	var mode: String = str(params.get("mode", "mesh"))
+	var target = null
+	var body = null
+	var reused := false
+	if bool(params.get("reuse_existing", true)):
+		var existing = parent.get_node_or_null(NodePath(target_name))
+		if existing != null and existing is MeshInstance3D:
+			target = existing
+			reused = true
+			if existing.get_parent() is StaticBody3D:
+				body = existing.get_parent()
+	if target == null:
+		if mode == "static_body":
+			body = StaticBody3D.new()
+			body.name = target_name
+			body.collision_layer = int(params.get("collision_layer", 3))
+			body.collision_mask = int(params.get("collision_mask", 1))
+			parent.add_child(body)
+			var shape_node := CollisionShape3D.new()
+			shape_node.name = "CollisionShape3D"
+			shape_node.shape = mesh.create_trimesh_shape()
+			body.add_child(shape_node)
+			target = MeshInstance3D.new()
+			target.name = "Mesh"
+			body.add_child(target)
+		else:
+			target = MeshInstance3D.new()
+			target.name = target_name
+			parent.add_child(target)
+
+	target.mesh = mesh
+	for prop in CSG_CARRY_PROPS:
+		target.set(prop, csg.get(prop))
+	var root_node: Node3D = body if body != null else target
+	root_node.global_transform = csg.global_transform
+
+	if bool(params.get("delete_csg", false)):
+		csg.queue_free()
+	elif not bool(params.get("keep_csg", false)):
+		# Non-destructive default: stop the CSG from rendering/colliding.
+		csg.visible = false
+		csg.use_collision = false
+
+	return {
+		"success": true,
+		"mesh_path": str(target.get_path()),
+		"root_path": str(root_node.get_path()),
+		"surface_count": mesh.get_surface_count(),
+		"mode": mode,
+		"reused_existing": reused,
+		"unwrap_error": unwrap_error,
+		"csg_kept": not bool(params.get("delete_csg", false)),
+	}
+
+
+# --- G6: read back the material that is actually rendering ------------------
+func _cmd_get_material_state(params: Dictionary) -> void:
+	_send_response(get_material_state_core(params))
+
+
+func get_material_state_core(params: Dictionary) -> Dictionary:
+	var node_path: String = str(params.get("node_path", ""))
+	var node = get_tree().root.get_node_or_null(node_path)
+	if node == null:
+		return {"error": "Node not found: %s" % node_path}
+	var out := {"success": true, "node_path": node_path, "node_class": str(node.get_class())}
+	var mi = node as MeshInstance3D
+	if mi == null:
+		var generic = node.get("material_override")
+		if generic is Material:
+			out["material_override"] = _describe_material(generic)
+		var own = node.get("material")
+		if own is Material:
+			out["material"] = _describe_material(own)
+		return out
+
+	if mi.material_override != null:
+		out["material_override"] = _describe_material(mi.material_override)
+	if mi.material_overlay != null:
+		out["material_overlay"] = _describe_material(mi.material_overlay)
+	out["gi_mode"] = mi.gi_mode
+	out["gi_lightmap_scale"] = mi.gi_lightmap_scale
+	var surfaces: Array = []
+	var count := 0
+	if mi.mesh != null:
+		count = mi.mesh.get_surface_count()
+		for i in count:
+			var entry := {"surface": i}
+			var mesh_mat = mi.mesh.surface_get_material(i)
+			if mesh_mat != null:
+				entry["mesh_material"] = _describe_material(mesh_mat)
+			var override_mat = mi.get_surface_override_material(i)
+			if override_mat != null:
+				entry["surface_override"] = _describe_material(override_mat)
+			var active = mi.get_active_material(i)
+			if active != null:
+				entry["active"] = _describe_material(active)
+			surfaces.append(entry)
+	out["surface_count"] = count
+	out["surfaces"] = surfaces
+	return out
+
+
+func _describe_material(mat: Material) -> Dictionary:
+	var d := {
+		"class": str(mat.get_class()),
+		"resource_path": str(mat.resource_path),
+		"resource_name": str(mat.resource_name),
+	}
+	if mat is ShaderMaterial:
+		var sm := mat as ShaderMaterial
+		var shader = sm.shader
+		d["shader_path"] = str(shader.resource_path) if shader != null else ""
+		var uniforms := {}
+		if shader != null:
+			for u in shader.get_shader_uniform_list():
+				var uname := str(u.get("name", ""))
+				if uname.is_empty():
+					continue
+				uniforms[uname] = _variant_to_json(sm.get_shader_parameter(uname))
+		d["shader_parameters"] = uniforms
+	elif mat is BaseMaterial3D:
+		var bm := mat as BaseMaterial3D
+		d["albedo_color"] = _variant_to_json(bm.albedo_color)
+		d["albedo_texture"] = str(bm.albedo_texture.resource_path) if bm.albedo_texture != null else ""
+		d["roughness"] = bm.roughness
+		d["metallic"] = bm.metallic
+	return d
+
+
+# --- G7b (partial): UV2 for lightmaps and occluders from a mesh -------------
+func _cmd_unwrap_lightmap_uv2(params: Dictionary) -> void:
+	_send_response(unwrap_lightmap_uv2_core(params))
+
+
+func unwrap_lightmap_uv2_core(params: Dictionary) -> Dictionary:
+	var node_path: String = str(params.get("node_path", ""))
+	var node = get_tree().root.get_node_or_null(node_path)
+	if node == null:
+		return {"error": "Node not found: %s" % node_path}
+	if not (node is MeshInstance3D) or (node as MeshInstance3D).mesh == null:
+		return {"error": "node_path must be a MeshInstance3D with a mesh: %s" % node_path}
+	var mi := node as MeshInstance3D
+	var src = mi.mesh
+	var am = src as ArrayMesh
+	if am == null:
+		am = ArrayMesh.new()
+		for i in src.get_surface_count():
+			am.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, src.surface_get_arrays(i))
+			am.surface_set_material(i, src.surface_get_material(i))
+	var err: int = am.lightmap_unwrap(mi.global_transform, float(params.get("texel_size", 0.4)))
+	if err != OK:
+		return {"error": "lightmap_unwrap failed with error %d (mesh may already carry UV2, or it has no faces)" % err}
+	mi.mesh = am
+	if params.has("gi_mode"):
+		mi.gi_mode = int(params["gi_mode"]) as GeometryInstance3D.GIMode
+	else:
+		mi.gi_mode = GeometryInstance3D.GI_MODE_STATIC
+	if params.has("gi_lightmap_scale"):
+		mi.gi_lightmap_scale = int(params["gi_lightmap_scale"]) as GeometryInstance3D.LightmapScale
+	return {
+		"success": true,
+		"node_path": node_path,
+		"surface_count": am.get_surface_count(),
+		"gi_mode": mi.gi_mode,
+		"note": "UV2 generated; the actual lightmap bake still needs the editor (no script API in 4.7.2).",
+	}
+
+
+func _collect_mesh_instances(node: Node, out: Array) -> void:
+	if node is MeshInstance3D:
+		out.append(node)
+	for child in node.get_children():
+		_collect_mesh_instances(child, out)
