+            var ret_class = str(ret.get("class_name", ""))
+            methods.append({
+                "name": mname,
+                "returns": ret_class if not ret_class.is_empty() else str(ret.get("type", "")),
+                "argc": m.get("args", []).size(),
+                "static": bool(int(m.get("flags", 0)) & METHOD_FLAG_STATIC)
