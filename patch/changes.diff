+# --- G10: compare two rendered images (visual regression) --------------------
+func _cmd_compare_images(params: Dictionary) -> void:
+	_send_response(compare_images_core(params))
+
+
+func compare_images_core(params: Dictionary) -> Dictionary:
+	var base_path := str(params.get("baseline_path", ""))
+	var cur_path := str(params.get("current_path", ""))
+	if base_path.is_empty() or cur_path.is_empty():
+		return {"error": "baseline_path and current_path are required (res://, user:// or absolute OS paths)"}
+	var baseline := Image.new()
+	var current := Image.new()
+	var err_base: int = baseline.load(base_path)
+	var err_cur: int = current.load(cur_path)
+	if err_base != OK or err_cur != OK:
+		return {"error": "Image.load failed (baseline=%d, current=%d); check the paths" % [err_base, err_cur]}
+	if baseline.get_size() != current.get_size():
+		return {"error": "size mismatch: baseline %s vs current %s" % [str(baseline.get_size()), str(current.get_size())]}
+	# compute_image_metrics returns max/mean/mean_squared/root_mean_squared/peak_snr
+	# (4.7.2 - note: the key is root_mean_squared, there is no "rmse" key).
+	var metrics = baseline.compute_image_metrics(current, bool(params.get("compare_hashes", false)))
+	var out := {
+		"success": true,
+		"size": {"x": baseline.get_width(), "y": baseline.get_height()},
+		"metrics": _variant_to_json(metrics),
+	}
+	var rmse := -1.0
+	var max_channel := -1
+	if metrics is Dictionary:
+		rmse = float(metrics.get("root_mean_squared", metrics.get("rmse", -1.0)))
+		max_channel = int(metrics.get("max", -1))
+	out["rmse"] = rmse
+	out["max_channel_delta_255"] = max_channel
+	out["identical"] = rmse == 0.0
+	if params.has("rmse_threshold"):
+		out["rmse_threshold"] = float(params["rmse_threshold"])
+		out["passes_threshold"] = rmse >= 0.0 and rmse <= float(params["rmse_threshold"])
+	if params.has("diff_output_path"):
+		var diff = Image.create(baseline.get_width(), baseline.get_height(), false, Image.FORMAT_RGBA8)
+		var max_delta := 0.0
+		for y in baseline.get_height():
+			for x in baseline.get_width():
+				var pa := baseline.get_pixel(x, y)
+				var pb := current.get_pixel(x, y)
+				var d: float = maxf(maxf(absf(pa.r - pb.r), absf(pa.g - pb.g)), maxf(absf(pa.b - pb.b), absf(pa.a - pb.a)))
+				max_delta = maxf(max_delta, d)
+				diff.set_pixel(x, y, Color(d, d, d, 1.0))
+		out["max_channel_delta"] = max_delta
+		var diff_path := str(params["diff_output_path"])
+		var derr: int = diff.save_png(diff_path)
+		out["diff_output_path"] = diff_path
+		out["diff_save_error"] = derr
+	return out
+
