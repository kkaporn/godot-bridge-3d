+    while queue.size() > 0 and nodes.size() < max_nodes:
+        var cur = queue.pop_front()
+        if visited.has(cur):
+            continue
+        visited[cur] = true
+        var exists = ResourceLoader.exists(cur)
+        var entry = {"path": cur, "exists": exists, "class": "", "deps": [], "sidecars": _sidecar_report(cur)}
+        if exists:
+            var res = load(cur)
+            if res != null:
