+    var props = []
+    var prop_total = 0
+    for p in ClassDB.class_get_property_list(cls, true):
+        var pname = str(p.name)
+        if not _keyword_hit(pname, keywords):
+            continue
+        prop_total += 1
+        if props.size() < max_items:
+            props.append({
+                "name": pname,
+                "type": int(p.get("type", 0)),
+                "usage": int(p.get("usage", 0))
+            })
+
+    var signals = []
+    for s in ClassDB.class_get_signal_list(cls, true):
