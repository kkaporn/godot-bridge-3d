+func _find_dep_cycles(node, edges, state, stack, cycles, depth, max_depth):
+    if depth > max_depth:
+        return
+    var st = int(state.get(node, 0))
+    if st == 2:
+        return
+    if st == 1:
+        var idx = stack.find(node)
+        if idx >= 0:
+            var chain = stack.slice(idx)
+            chain.append(node)
+            cycles.append(chain)
+        return
+    state[node] = 1
+    stack.append(node)
+    for dep in edges.get(node, []):
+        if edges.has(dep):
+            _find_dep_cycles(dep, edges, state, stack, cycles, depth + 1, max_depth)
+    stack.pop_back()
+    state[node] = 2
