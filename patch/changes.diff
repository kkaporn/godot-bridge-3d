+    _emit_json({
+        "success": true,
+        "path": res_path,
+        "nodes": nodes,
+        "nodes_total": nodes.size(),
+        "truncated": nodes.size() >= max_nodes,
+        "missing": missing,
+        "cycles": cycles,
+        "sidecar_issues": sidecar_issues,
+        "ok": missing.is_empty() and cycles.is_empty() and sidecar_issues.is_empty()
+    })
+    print("Dependency scan for: " + res_path + " (" + str(nodes.size()) + " nodes, " + str(missing.size()) + " missing)")
